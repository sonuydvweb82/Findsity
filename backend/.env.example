# Findsity backend environment variables
# Copy this file to backend/.env and fill in your values.

# Server
PORT=4000
NODE_ENV=development

# Frontend origin (for CORS in production)
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string.
# If left empty, the backend uses an embedded PostgreSQL (PGlite) stored in backend/data/
# so the app runs out of the box without installing PostgreSQL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/findsity

# Authentication
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Image uploads: Cloudinary (optional).
# When set, images are uploaded to Cloudinary. When empty, images are stored
# locally in backend/uploads/ and served from /uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=